#!/bin/sh
set -e
if [ "$1" = configure ]; then
  pam-auth-update --package || true
  udevadm control --reload-rules || true
  if [ -e /sys/module/spidev/parameters/bufsiz ] && \
     [ "$(cat /sys/module/spidev/parameters/bufsiz)" -lt 65536 ]; then
    modprobe -r spidev 2>/dev/null || true
  fi
  udevadm trigger --action=add --subsystem-match=spi || true
  udevadm settle || true
  systemctl daemon-reload || true
  systemctl try-restart fprintd.service || true
  if [ ! -s /var/lib/lg-gram-fingerprint/sensor-config.bin ]; then
    echo
    echo "  lg-gram-fingerprint: one more step - run:   sudo lg-gram-fp-tool setup"
    echo
  fi
fi
#DEBHELPER#
